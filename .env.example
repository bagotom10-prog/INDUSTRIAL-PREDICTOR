# Copia este archivo a .env y rellena lo que necesites. .env no se sube a git.

# Opcional: activa el diagnóstico redactado por Claude. Sin clave se usa el
# diagnóstico por reglas, que copia acción y plazo del manual.
ANTHROPIC_API_KEY=

# Modelo de Claude para el diagnóstico (por defecto claude-opus-5-5).
# INSPECTOR_MODELO_LLM=claude-opus-5-5

# auto (LLM si hay clave) | llm | reglas | ninguno
# INSPECTOR_DIAGNOSTICO=auto

# Rutas (útiles dentro de Docker)
# INSPECTOR_PESOS=runs/detect/n_640/weights/best.pt
# INSPECTOR_CRITERIOS=manual_criterios.yaml
# INSPECTOR_MANUAL_PDF=manual/manual_calidad.pdf
